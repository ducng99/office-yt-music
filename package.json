{
  "name": "office-music",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/extension build",
    "start": "bun run --cwd apps/server start",
    "create-user": "bun run --cwd apps/server create-user",
    "test": "cd apps/server && bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.14.0",
    "typescript": "6",
    "typescript-eslint": "^8.72.1"
  }
}
