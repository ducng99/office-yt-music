{
  "name": "office-yt-music",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "build": "bun run --cwd packages/web build && bun run --cwd packages/extension build",
    "start": "bun run --cwd packages/server start",
    "create-user": "bun run --cwd packages/server create-user",
    "test": "cd packages/server && bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.14.0",
    "typescript": "6",
    "typescript-eslint": "^8.72.1"
  }
}
